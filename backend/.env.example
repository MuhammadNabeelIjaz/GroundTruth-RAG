# Copy this file to `.env` and edit the copy. Never commit `.env`.
# All values below are placeholders.

APP_NAME=GroundTruth-RAG
APP_VERSION=0.1.0

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Optional: override where runtime and sample data are stored (defaults are under ./data)
# UPLOADS_DIR=data/uploads
# SAMPLE_DIR=data/sample_pdfs
# CHROMA_DIR=data/chroma

# Largest accepted PDF upload in megabytes (default 20)
# MAX_UPLOAD_MB=20

# Chunking, in characters (defaults 800 / 120; size >= 100, 0 <= overlap < size).
# Recommended for all-MiniLM-L6-v2 (256-token limit) with dense PDFs/slides: 300 / 50.
# CHUNK_SIZE=300
# CHUNK_OVERLAP=50
# TOKEN_AWARE_CHUNKING=true

# Added in later stages (not used yet):
# LLM_API_KEY=your-api-key-here

# Embeddings (Stage 3). The model is downloaded from Hugging Face on first real use.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=32
# CHROMA_COLLECTION_NAME=document_chunks

# Retrieval (Stage 4).
# RETRIEVAL_TOP_K=5
# MIN_SIMILARITY=0.0

# LLM / Groq API (Stage 5).
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_TEMPERATURE=0.0
# LLM_TIMEOUT_SECONDS=30.0

# Multi-Turn Conversations (Stage 7).
# CONVERSATIONS_DB_PATH=data/conversations.db
# MAX_HISTORY_TURNS=10

# CORS Allowed Origins: comma-separated list, JSON array, or * for wildcard
# Examples:
# CORS_ORIGINS=https://my-app.netlify.app,http://localhost:5173
# CORS_ORIGINS=*
# CORS_ORIGIN_REGEX=^https?://.*\.example\.com$
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
